# Secrets used by the arbiter backend.
# Copy this file to .env.local on the arbiter server.
# Never commit .env.local or share its values.
#
# Use the same key for every instance and Initialize call.
# The value is a base64-encoded Solana secret key. Generate it locally.
#
# This one key controls the HP mint and vault.
# HP ElGamal and AES keys are created automatically. No extra env vars are needed.

ARBITER_AUTHORITY_SECRET_KEY_BASE64=

# Backend RPC. Instantiated per request. Must be a ZK-capable cluster for
# Confidential Balances. Do not prefix with NEXT_PUBLIC_.
SOLANA_RPC_URL=

# Shared HP mint (DEP6). Cluster-specific. Token-2022 confidential mint+burn
# whose mint authority is the arbiter key above.
HP_MINT=
