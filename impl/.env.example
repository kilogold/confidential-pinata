# Arbiter backend secrets for impl/app.
# Copy to .env.local (gitignored). That file MUST exist only on the arbiter host.
# Next.js loads it from impl/, the Next project root.
#
# Owned by docs/arbiter.md A2 and docs/deployment.md DEP2, DEP5, DEP6.
# Reused for every instance and every Initialize. Do not generate per session.
# Do not prefix these with NEXT_PUBLIC_ — that would ship secrets to the frontend (A6).
# An env file on the host is not isolation enforcement (arbiter.md O1).
#
# Encoding: unpadded base64 of raw bytes. Generate locally; do not commit values.

# HP mint authority and HP vault authority (DEP5, DEP6). Simplest v1: one 64-byte
# Solana secret key for both. If ARBITER_HP_VAULT_AUTHORITY_SECRET_KEY_BASE64 is
# unset, the vault authority is this keypair.
ARBITER_AUTHORITY_SECRET_KEY_BASE64=

# Optional. 64-byte Solana secret key. Set only to split vault authority from mint authority.
# ARBITER_HP_VAULT_AUTHORITY_SECRET_KEY_BASE64=

# Shared HP mint ConfidentialMintBurn keys (A2). Reused. Distinct from vault keys.
# ElGamal secret: 32 bytes. Supply AES (AeKey): 16 bytes.
ARBITER_HP_SUPPLY_ELGAMAL_SECRET_BASE64=
ARBITER_HP_SUPPLY_AES_KEY_BASE64=

# HP vault encryption (A2) and ApplyPendingBalance decryptable balance (F1).
# Reused across instances and sessions. ElGamal secret: 32 bytes. AES (AeKey): 16 bytes.
ARBITER_HP_VAULT_ELGAMAL_SECRET_BASE64=
ARBITER_HP_VAULT_AES_KEY_BASE64=
